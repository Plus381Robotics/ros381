<?xml version="1.0"?>
<robot name="ros381">

  <!-- MATERIALS -->
  <material name="steel">
    <color rgba="0.8 0.8 0.8 1.0"/>
  </material>

  <material name="orange">
    <color rgba="0.8 0.2 0.0 1.0"/>
  </material>

  <material name="black">
    <color rgba="0.2 0.2 0.2 1.0"/>
  </material>

  <material name="black_plexi">
    <color rgba="0.1 0.1 0.1 1.0"/>
  </material>

  <link name="base_link">
    <visual>
      <geometry>
		<mesh filename="package://ros381_description/meshes/base.stl"/>
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 1.570796327"/>
      <material name="steel"/>
    </visual>
    <inertial>
      <origin xyz="0 0 0.1675"/>
      <mass value="2.0"/>
      <inertia ixx="0.044" iyy="0.02" izz="0.03" ixy="0.0" iyz="0.0" ixz="0.0"/>
    </inertial>
    <collision>
      <origin xyz="0 0 0.000" rpy="0 0 0"/>
      <geometry>
		<cylinder radius="0.14" length="0.004"/>
      </geometry>
    </collision>
  </link>

  <link name="wheel_right">
    <visual>
      <geometry>
        <cylinder radius="0.035" length="0.039"/>
      </geometry>
      <origin rpy="0 0 0"/>
      <material name="orange"/>
    </visual>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.1"/>
      <inertia 
        ixx="5e-5" iyy="5e-5" izz="8e-5" 
        ixy="0.0" iyz="0.0" ixz="0.0"/>
    </inertial>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.035" length="0.039"/>
      </geometry>
    </collision>
  </link>
  <joint name="wheel_right" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_right"/>
    <axis xyz="0.0 0.0 -1.0"/>
    <origin xyz="0.0 -0.07725 0.032" rpy="1.570796327 0 0"/>
  </joint> 
  
  <link name="wheel_left">
    <visual>
      <geometry>
        <cylinder radius="0.035" length="0.039"/>
      </geometry>
      <origin rpy="0 0 0"/>
      <material name="orange"/>
    </visual>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.1"/>
      <inertia 
        ixx="5e-5" iyy="5e-5" izz="8e-5" 
        ixy="0.0" iyz="0.0" ixz="0.0"/>
    </inertial>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.035" length="0.039"/>
      </geometry>
    </collision>
  </link>
  <joint name="wheel_left" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_left"/>
    <axis xyz="0.0 0.0 -1.0"/>
    <origin xyz="0.0 0.07725 0.032" rpy="1.570796327 0 0"/>
  </joint>

  <link name="right_odometry_block">
    <visual>
      <geometry>
        <box size="0.09 0.015 0.05"/>
      </geometry>
      <origin xyz="0 0 0.025"/>
      <material name="steel"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.025"/>
      <geometry>
        <box size="0.09 0.015 0.05"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
      <mass value="0.0622"/>
      <inertia 
        ixx="1.41e-5" iyy="5.49e-5" izz="4.31e-5" 
        ixy="0.0" iyz="0.0" ixz="0.0"/>
    </inertial>
  </link>
  <joint name="right_odometry_slider" type="prismatic">
    <parent link="base_link"/>
    <child link="right_odometry_block"/>
    <axis xyz="0 0 1"/>
    <limit lower="0.0" upper="0.03" effort="0" velocity="100"/>
    <dynamics damping="0.1"/>
    <origin xyz="0 -0.134 0.015"/>
  </joint>

  <link name="left_odometry_block">
    <visual>
      <geometry>
        <box size="0.09 0.015 0.05"/>
      </geometry>
      <origin xyz="0 0 0.025"/>
      <material name="steel"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.025"/>
      <geometry>
        <box size="0.09 0.015 0.05"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
      <mass value="0.0622"/>
      <inertia 
        ixx="1.41e-5" iyy="5.49e-5" izz="4.31e-5" 
        ixy="0.0" iyz="0.0" ixz="0.0"/>
    </inertial>
  </link>
  <joint name="left_odometry_slider" type="prismatic">
    <parent link="base_link"/>
    <child link="left_odometry_block"/>
    <axis xyz="0 0 1"/>
    <limit lower="0.0" upper="0.03" effort="0" velocity="100"/>
    <dynamics damping="0.1"/>
    <origin xyz="0 0.134 0.015"/>
  </joint>

  <link name="odometry_wheel_right">
    <visual>
      <geometry>
        <cylinder radius="0.036" length="0.002"/>
      </geometry>
      <origin rpy="0 0 0"/>
      <material name="steel"/>
    </visual>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.055"/>
      <inertia 
        ixx="1.79e-5" iyy="1.79e-5" izz="3.56e-5" 
        ixy="0.0" iyz="0.0" ixz="0.0"/>
    </inertial>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.036" length="0.002"/>
      </geometry>
    </collision>
  </link>
  <joint name="odometry_wheel_right" type="continuous">
    <parent link="right_odometry_block"/>
    <child link="odometry_wheel_right"/>
    <axis xyz="0.0 0.0 -1.0"/>
    <origin xyz="0 -0.0145 0" rpy="1.570796327 0 0"/>
  </joint> 

  <link name="odometry_wheel_left">
    <visual>
      <geometry>
        <cylinder radius="0.036" length="0.002"/>
      </geometry>
      <origin rpy="0 0 0"/>
      <material name="steel"/>
    </visual>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.055"/>
      <inertia 
        ixx="1.79e-5" iyy="1.79e-5" izz="3.56e-5" 
        ixy="0.0" iyz="0.0" ixz="0.0"/>
    </inertial>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.036" length="0.002"/>
      </geometry>
    </collision>
  </link>
  <joint name="odometry_wheel_left" type="continuous">
    <parent link="left_odometry_block"/>
    <child link="odometry_wheel_left"/>
    <axis xyz="0.0 0.0 -1.0"/>
    <origin xyz="0 0.0145 0" rpy="1.570796327 0 0"/>
  </joint>

  <link name="armor">
    <visual>
      <geometry>
		<mesh filename="package://ros381_description/meshes/armor.stl"/>
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <material name="black_plexi"/>
    </visual>
    <inertial>
      <origin xyz="0 0 0.1675"/>
      <mass value="2.0"/>
      <inertia ixx="0.044" iyy="0.02" izz="0.03" ixy="0.0" iyz="0.0" ixz="0.0"/>
    </inertial>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://ros381_description/meshes/base_collision.stl"/>
      </geometry>
    </collision>
  </link>
  <joint name="armor_joint" type="fixed">
	<parent link="base_link"/>
	<child link="armor"/>
    <origin xyz="0 0 0" rpy="0 0 1.570796327"/>
  </joint>

  <webots>
	<device reference="wheel_right" type="RotationalMotor">
      <maxTorque>10</maxTorque>
      <maxVelocity>60</maxVelocity>
      <acceleration>600</acceleration>
    </device>
    <device reference="wheel_left" type="RotationalMotor">
      <maxTorque>10</maxTorque>
      <maxVelocity>60</maxVelocity>
      <acceleration>600</acceleration>
    </device>
    <device reference="right_odometry_slider" type="LinearMotor">
      <maxForce>1</maxForce>
      <maxVelocity>100</maxVelocity>
      <maxPosition>0.03</maxPosition>
    </device>
    <device reference="left_odometry_slider" type="LinearMotor">
      <maxForce>1</maxForce>
      <maxVelocity>100</maxVelocity>
      <maxPosition>0.03</maxPosition>
    </device>
    <device reference="odometry_wheel_right" type="RotationalMotor">
      <maxTorque>0</maxTorque>
    </device>
    <device reference="odometry_wheel_left" type="RotationalMotor">
      <maxTorque>0</maxTorque>
    </device>
    <plugin type="ros381_webots.motor_driver.MotorDriver"/>
    <plugin type="ros381_webots.encoder_reader.EncoderReader"/>
  </webots>
</robot>